# Copy the values you need into your environment (the server does not read .env files by itself).
ASCEND_ADDR=:8080
ASCEND_STORE=sqlite
ASCEND_DB_PATH=data/ascend.db
ASCEND_TIMEZONE=America/Bogota
ASCEND_SEED=demo
ASCEND_USER_NAME=
ASCEND_ALLOW_RESET=true
ASCEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ASCEND_API_TOKEN=
ASCEND_LOG_LEVEL=info
